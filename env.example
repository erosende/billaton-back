# Database Configuration
BILLATON_DB_URL=jdbc:postgresql://db:5432/billaton
BILLATON_DB_USERNAME=billaton
BILLATON_DB_PASSWORD=your_db_password_here

# PostgreSQL Container Configuration
POSTGRES_DB=billaton
POSTGRES_USER=billaton
POSTGRES_PASSWORD=your_db_password_here

# Cloudflare R2 Configuration
R2_ACCESS_KEY=your_r2_access_key_here
R2_SECRET_KEY=your_r2_secret_key_here
R2_DOCUMENTS_BUCKET=your_documents_bucket_here
R2_IMAGES_BUCKET=your_images_bucket_here
R2_ENDPOINT=your_r2_endpoint_here

# Supabase Configuration
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Application Configuration
PORT=8080